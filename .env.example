PORT=3000

# OPCIÓN 1: Conexión local para MongoDB Compass (activa por defecto para desarrollo)
MONGO_URI=mongodb://127.0.0.1:27017/ecogolgi_db

# OPCIÓN 2: Conexión a MongoDB Atlas (reemplazar credenciales y descomentar para usar en la nube; esta misma URI sirve en Compass)
# MONGO_URI=mongodb+srv://<USUARIO>:<PASSWORD>@cluster0.tucluster.mongodb.net/ecogolgi_db?retryWrites=true&w=majority

